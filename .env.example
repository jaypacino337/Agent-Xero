# ===== Agent Xero configuration =====
# Copy to .env and fill in. NEVER commit .env.

# --- Safety ---
# Keep true until you have verified behavior. When true, no real transactions are sent;
# trades, buybacks and burns are simulated against live prices and logged identically.
PAPER_TRADING=true

# --- Trading engine ---
# chill = fewer/higher-conviction trades · normal = defaults · degen = trade a lot
# (sets defaults for MIN_SCORE_TO_BUY, MAX_OPEN_POSITIONS and volume thresholds;
#  any explicit value below still wins)
AGGRESSIVENESS=normal
SOL_PER_TRADE=0.25
MAX_OPEN_POSITIONS=6
DAILY_LOSS_LIMIT_SOL=2.0
# Entry filter: only buy while market cap is below this (USD)
ENTRY_MAX_MC_USD=10000
# "Runner" target: begin scaling out when market cap crosses this (USD)
TARGET_MC_USD=100000
TAKE_PROFIT_SELL_PCT=60        # % of position sold when target hit
STOP_LOSS_PCT=45               # % drawdown from entry that triggers full exit
TRAILING_STOP_PCT=30           # % retrace from peak after target hit
MIN_SCORE_TO_BUY=55            # 0-100 composite signal score required to enter

# --- Smart wallet confluence ---
# Comma-separated list of high-quality profitable wallet addresses to track
SMART_WALLETS=
CONFLUENCE_MIN_WALLETS=2       # this many tracked wallets buying same token within window = signal
CONFLUENCE_WINDOW_SEC=300

# --- Volume threshold signal ---
VOLUME_THRESHOLD_SOL=40        # buy-volume (SOL) within window that fires the volume signal
VOLUME_WINDOW_SEC=120
MIN_UNIQUE_BUYERS=25

# --- Telegram signal ingestion (calls channel you forward when online) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs the bot will accept calls from (empty = accept none)
TELEGRAM_ALLOWED_CHATS=
# Comma-separated user IDs allowed to send admin commands (/status /halt /resume)
TELEGRAM_ADMIN_IDS=

# --- Execution (PumpPortal Lightning API; ignored while PAPER_TRADING=true) ---
PUMPPORTAL_API_KEY=
WALLET_PUBLIC_KEY=
PRIORITY_FEE_SOL=0.0005
SLIPPAGE_PCT=15

# --- $XERO token / buyback & burn ---
XERO_MINT=
# % of realized profit routed to buyback-and-burn (rest of the split below)
BUYBACK_PROFIT_PCT=70
# Minimum accumulated SOL before a buyback executes
BUYBACK_MIN_SOL=0.1
# Solana incinerator address (do not change unless you know why)
BURN_ADDRESS=1nc1nerator11111111111111111111111111111111

# --- Holder airdrops (flywheel arm #2) ---
AIRDROP_ENABLED=true
# % of realized trading profit routed to the holder airdrop pool
AIRDROP_PROFIT_PCT=30
# % of callout rewards (pump.fun fee share from calls) routed to airdrops
CALLOUT_REWARDS_AIRDROP_PCT=100
# Minimum accumulated SOL before a drop executes
AIRDROP_MIN_SOL=0.5
# random = holdings-weighted lottery, N winners split the pool
# linear = pro-rata by holdings
AIRDROP_MODE=random
AIRDROP_RANDOM_WINNERS=10
# ignore dust wallets below this % of supply
AIRDROP_MIN_HOLDING_PCT=0.05
# wallets never eligible (LP pools, exchange wallets, team) — comma separated
AIRDROP_EXCLUDE=
AIRDROP_MAX_RECIPIENTS=200

# --- On-chain (live burns + live airdrops) ---
# Solana RPC; a Helius/Triton/etc endpoint is strongly recommended over the public one
RPC_URL=https://api.mainnet-beta.solana.com
# Helius API key: fast holder snapshots (falls back to raw RPC scan without it)
HELIUS_API_KEY=
# Operator wallet secret key (base58, e.g. from PumpPortal wallet creation, or JSON array).
# Used to burn bought-back $XERO on-chain and send airdrop SOL. Keep this safe.
WALLET_SECRET_KEY=

# --- X (Twitter) ---
X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_USER_ID=
# Comma-separated handles Xero is allowed to engage with (e.g. aixbt_agent)
X_ENGAGE_HANDLES=aixbt_agent
X_MENTION_POLL_SEC=120
MAX_POSTS_PER_HOUR=8

# --- Persona (Claude) ---
ANTHROPIC_API_KEY=
PERSONA_MODEL=claude-fable-5

# --- Site links (header buttons; all optional) ---
# Buy button URL; defaults to https://pump.fun/coin/<XERO_MINT> when the mint is set
BUY_URL=
# Xero's X handle (without @) -> "follow on X" button
X_HANDLE=
# Community telegram invite link -> "telegram" button
TELEGRAM_URL=

# --- Site / API ---
PORT=3000
# Where the JSON ledger lives (Railway: attach a volume at /data and set DATA_DIR=/data)
DATA_DIR=
# If set, admin endpoints accept "Authorization: Bearer <token>" from anywhere
# (otherwise localhost only). Generate something long and random.
ADMIN_TOKEN=
